{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genesis",
  "version": "0.1.0",
  "identifier": "io.github.muse254.genesis",
  "build": {
    "frontendDist": "../../console-ui/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../console-ui run dev",
    "beforeBuildCommand": "npm --prefix ../console-ui run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/genesis-console"
    ],
    "shortDescription": "Register photographs against the camera that took them"
  }
}
