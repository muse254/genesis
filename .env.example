# Every credential this project needs, and what breaks without it.
# Copy to .env (gitignored) and fill in. Nothing here belongs in git.

# ─── Chain ────────────────────────────────────────────────────────────────
# Sepolia because ENSv2's testnet deployment is there. If ENS is cut, this
# reopens and Base Sepolia is cheaper and faster.
#
# No signup needed: https://ethereum-sepolia-rpc.publicnode.com answers today
# and is enough to deploy and register. A dedicated key (dashboard.alchemy.com
# -> Create app -> Ethereum/Sepolia -> View Key, or developer.metamask.io)
# only matters if something starts hammering the RPC.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Needs Sepolia ETH. Faucet: https://cloud.google.com/application/web3/faucet/ethereum/sepolia
# Used by forge as --private-key. A throwaway key, never one that holds value.
DEPLOYER_PRIVATE_KEY=

# Optional. Only for `forge verify-contract`, so the registry source is
# readable on Etherscan. etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ─── Deployed contracts — fill in after the deploy, then FREEZE ───────────
REGISTRY_ADDRESS=
# The block the registry was deployed in. The subgraph's startBlock: getting
# this wrong means indexing from genesis, which takes hours for nothing.
REGISTRY_START_BLOCK=

# ─── ENSv2 on Sepolia — pin these and do not chase changes ───────────────
# The parent name has to be registered on Sepolia first; a mainnet name does
# not carry over. Costs Sepolia ETH from the same faucet.
ENS_PERMISSIONED_REGISTRY=
ENS_PERMISSIONED_RESOLVER=
ENS_ETH_REGISTRAR=
ENS_UNIVERSAL_RESOLVER_V2=
ENS_PARENT_NAME=cam.osoro.eth

# ─── The Graph ────────────────────────────────────────────────────────────
# thegraph.com/studio -> create a subgraph -> copy the deploy key.
# Studio does its own indexing, so it never touches SEPOLIA_RPC_URL.
GRAPH_DEPLOY_KEY=
# Filled in by `graph deploy`; the MCP server and verify page read it.
SUBGRAPH_URL=

# ─── Chainlink CRE — stretch, and first in the cut order ─────────────────
# Account: app.chain.link/cre/discover. Building and simulating need only
# the account and the CLI. DEPLOYING needs approval, requested with
# `cre account access` — a gate with unknown turnaround, which is a
# scheduling risk on a 13-day clock. Simulation alone still demos.
CRE_WORKFLOW_OWNER=

# ─── Local services ───────────────────────────────────────────────────────
SCORING_SERVICE_URL=http://127.0.0.1:8000
GENESIS_REFERENCES=data/references
# HMAC key for metadata commitments. Lose this and the commitments are
# unopenable; leak it and the geotags are readable.
METADATA_HMAC_KEY=
