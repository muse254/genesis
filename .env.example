# Chain — Sepolia because ENSv2's testnet deployment is there. If ENS is
# cut, this reopens and Base Sepolia is cheaper and faster.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=
DEPLOYER_PRIVATE_KEY=

# Deployed contracts — fill in on day 4, then FREEZE.
REGISTRY_ADDRESS=

# ENSv2 on Sepolia — pin these on day 4 and do not chase changes.
ENS_PERMISSIONED_REGISTRY=
ENS_PERMISSIONED_RESOLVER=
ENS_ETH_REGISTRAR=
ENS_UNIVERSAL_RESOLVER_V2=
ENS_PARENT_NAME=cam.osoro.eth

# Scoring service
SCORING_SERVICE_URL=http://127.0.0.1:8000
# HMAC key for metadata commitments. Lose this and the commitments are
# unopenable; leak it and the geotags are readable.
METADATA_HMAC_KEY=

# The Graph
SUBGRAPH_URL=
