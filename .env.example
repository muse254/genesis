# Every credential this project needs, and what breaks without it.
# Copy to .env (gitignored) and fill in. Nothing here belongs in git.

# ─── Chain ────────────────────────────────────────────────────────────────
# GENESIS_CHAIN picks the chain id, default RPC and explorers in one place
# (console/chain.py): base | base-sepolia | sepolia.
# Base mainnet is production (COLOSSEUM.md D1). Sepolia is the ETHOnline
# deployment, which stays readable.
GENESIS_CHAIN=base-sepolia
# Optional. Blank means the chain's public endpoint (mainnet.base.org,
# sepolia.base.org), which is rate-limited. A dedicated key (Alchemy, or
# similar) matters once strangers are verifying.
RPC_URL=
# forge reads these by name (contracts/foundry.toml).
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Still read on GENESIS_CHAIN=sepolia only.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The key that deploys the registry and registers the photographer's bodies
# and images. ON BASE MAINNET THIS HOLDS REAL ETH: fund it with only what the
# gas needs, never commit it, and keep it off every machine except this one.
# Base Sepolia ETH: https://docs.base.org/chain/network-faucets
# The address is read-only: the console's preflight checks it has gas before
# anything is sent.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# For `forge verify-contract`, so the registry source is readable on
# Basescan. One Etherscan V2 key covers every chain. etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ─── Deployed contracts — fill in after the deploy, then FREEZE ───────────
REGISTRY_ADDRESS=
# The block the registry was deployed in. The subgraph's startBlock: getting
# this wrong means indexing from genesis, which takes hours for nothing.
REGISTRY_START_BLOCK=

# ─── ENSv2 on Sepolia — ETHOnline only ───────────────────────────────────
# Not used on Base (COLOSSEUM.md D2). Kept for the Sepolia deployment and
# identity/. Leave ENS_PARENT_NAME blank on Base so preflight skips the check.
# The parent name has to be registered on Sepolia first; a mainnet name does
# not carry over. Costs Sepolia ETH from the same faucet.
# ENSv2 Sepolia, from docs.ens.domains/learn/deployments (8 Sep 2026).
# Verify before use; see identity/addresses.md.
ENS_ETH_REGISTRY=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ENS_ETH_REGISTRAR=0xa88553f454b77203b0d036a05c894d555eaaa2cc
ENS_UNIVERSAL_RESOLVER_V2=0x4a1817d13e9cf196f471725176355c1234b63c70
ENS_PERMISSIONED_RESOLVER=0xA0977579eC240023fa0B763BdE337e6A4AFe60F1
ENS_PUBLIC_RESOLVER_V2=0xe7b9a25607e02da8145e4eb1836ca539e53f11f7
ENS_PARENT_NAME=cam.osoro.eth

# ─── The Graph ────────────────────────────────────────────────────────────
# thegraph.com/studio -> create a subgraph -> copy the deploy key.
# Studio does its own indexing, so it never touches RPC_URL.
GRAPH_DEPLOY_KEY=
# Filled in by `graph deploy`; the MCP server and verify page read it.
SUBGRAPH_URL=

# ─── Chainlink CRE — stretch, and first in the cut order ─────────────────
# Account: app.chain.link/cre/discover. Building and simulating need only
# the account and the CLI. DEPLOYING needs approval, requested with
# `cre account access` — a gate with unknown turnaround, which is a
# scheduling risk on a 13-day clock. Simulation alone still demos.
#
# Only read on deploy. Simulation runs with no linked owner at all, which is
# why this being empty does not block the confidential path. Filling it means
# `cre account link-key`, which broadcasts a transaction and needs gas.
CRE_WORKFLOW_OWNER=

# Which backend `/score/confidential` uses. `local` is the default because it
# always works; `cre` runs the real workflow through `cre workflow simulate`.
# They agree on the number and NOT on what the number is worth — `cre/backend.py`
# spells out the three trust states and the response carries which one it is.
GENESIS_CONFIDENTIAL_BACKEND=local
# Long-lived API key from app.chain.link -> Account Settings. Without it the
# CLI uses ~/.cre/cre.yaml, whose access token lasts 900 seconds and is
# refreshed on use -- fine at a terminal, a liability on camera, because an
# expired token sends `cre login` to a browser and the demo stops. Measured:
# with no credentials at all, `cre workflow simulate` refuses before doing any
# work. Set this and the refresh cycle stops mattering.
CRE_API_KEY=
# Where the CRE CLI lives, if not ~/.cre/bin/cre.
CRE_BIN=
# secp256k1 key the local backend signs scores with, hex, no 0x. Optional: it
# exercises the verifier plumbing. It is NOT an attestation — the key sits on
# the same machine as K, so it attests nothing to anyone else.
GENESIS_ATTESTATION_KEY=

# ─── Local services ───────────────────────────────────────────────────────
SCORING_SERVICE_URL=http://127.0.0.1:8000
GENESIS_REFERENCES=data/references
# HMAC key for metadata commitments. Lose this and the commitments are
# unopenable; leak it and the geotags are readable.
METADATA_HMAC_KEY=

# Where the console's enrolment folder picker may look. Defaults to $HOME.
# Point it at an external drive if that is where the archive lives.
GENESIS_BROWSE_ROOT=
