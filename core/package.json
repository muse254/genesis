{
  "name": "genesis-core",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "npm run wasm:prnu && npm run wasm:jpeg",
    "wasm:prnu": "wasm-pack build ../rust/genesis-prnu-wasm --target web --release --out-dir ../../core/src/wasm",
    "wasm:jpeg": "./jpeg/build.sh",
    "test": "vitest run",
    "parity": "node --experimental-strip-types --no-warnings jpeg/parity.mjs"
  },
  "dependencies": {
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
