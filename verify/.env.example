# VITE_CHAIN: base | base-sepolia | sepolia | anvil (the same keys as
# GENESIS_CHAIN in the console). Base mainnet is production; its address is
# filled in once deployed.
#
# Base Sepolia -- the Colosseum rehearsal registry
# (docs/colosseum-checklist.md). Not the ETHOnline registry: that one is a
# different contract on a different chain (Ethereum Sepolia), still live
# and still readable, but no longer what this project points at.
VITE_SCORING_URL=http://127.0.0.1:8000
VITE_RPC_URL=https://sepolia.base.org
VITE_REGISTRY_ADDRESS=0x0C0F3Ec87339F985c509c01dEE8474BB8f5b0EB2
VITE_CHAIN=base-sepolia
# The Graph. Without it the perceptual branch cannot find the original a
# degraded copy descends from, and step 4 falls back to fingerprint-only.
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758974/genesis/v0.1.0-base-sepolia

# Local anvil instead, for development without spending testnet ETH.
# The address is whatever contracts/script/local-e2e.sh printed.
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# VITE_CHAIN=anvil

# The ETHOnline deployment, for reference only:
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_REGISTRY_ADDRESS=0xd1bbDB8A6BfD25563d2e6444fA41E4C5230Ed3C9
# VITE_CHAIN=sepolia
# VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758974/genesis/v0.0.5
