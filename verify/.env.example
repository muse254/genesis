# VITE_CHAIN: base | base-sepolia | sepolia | anvil (same keys as GENESIS_CHAIN).
# Base mainnet, the production registry.
VITE_RPC_URL=https://mainnet.base.org
VITE_REGISTRY_ADDRESS=0xBa5Ea549c9e1414C14038dB050e0caCB4f9E48cB
VITE_CHAIN=base
# Optional: where a registration links to.
VITE_EXPLORER_URL=https://basescan.org
# The Graph. Without it a degraded copy cannot be traced to its original.
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758974/genesis/v1.0.0-base

