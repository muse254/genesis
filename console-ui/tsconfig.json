{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "types": [
      "vite/client"
    ],
    "paths": {
      "@genesis/core": [
        "../core/src/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "../core/src"
  ]
}
